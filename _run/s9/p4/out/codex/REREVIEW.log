    \"composite_basis\": \"unverified\",\n    \"composite_basis_ref\": null,\n    \"varies_by_point\": false,\n    \"scope_note\": \"Frontier stub (tripwire-arc ingestion, RULING P4-11): post-Bruen Terry/reasonable-suspicion. Visible, lawful gun possession alone cannot ground reasonable suspicion, because carrying a firearm is presumptively lawful nationwide after Bruen; officers need particularized facts beyond the gun. Distinct from the 9th Cir. hash-match United States v. Luke Wilson (cluster 5296785). Treatment/progeny not derived until S6 promotion.\",\n    \"point_overrides\": [],\n    \"edges\": [],\n    \"derivation\": {}\n  },\n  \"provenance\": {\n    \"cl_source\": null,\n    \"cl_api\": \"https://www.courtlistener.com/api/rest/v4\",\n    \"built_by\": \"PROMO-FIX Stage-4 (P4-11)\",\n    \"build_run\": \"s9-p4-promo-fix\",\n    \"date_created\": \"2026-07-21T00:00:00Z\",\n    \"date_modified\": \"2026-07-21T00:00:00Z\",\n    \"warnings\": [],\n    \"field_provenance\": {\n      \"identity\": {\n        \"src\": \"RULING P4-11 identity fields (cluster/lead/docket/date/court)\",\n        \"at\": \"2026-07-21\",\n        \"verifier\": \"PROMO-FIX / claude-opus-4-8\"\n      },\n      \"treatment.field_i_validity\": {\n        \"src\": \"frontier stub, no treatment\",\n        \"at\": \"2026-07-21\",\n        \"verifier\": \"PROMO-FIX / claude-opus-4-8\"\n      },\n      \"pinpoints\": {\n        \"src\": \"frontier stub, no pinpoints\",\n        \"at\": \"2026-07-21\",\n        \"verifier\": \"PROMO-FIX / claude-opus-4-8\"\n      },\n      \"point_overrides\": {\n        \"src\": \"frontier stub, no treatment\",\n        \"at\": \"2026-07-21T12:40:00Z\",\n        \"verifier\": \"PROMO-FIX / claude-opus-4-8\"\n      }\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
