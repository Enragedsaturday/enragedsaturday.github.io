  "pinpoints": [
    {
      "id": "pin-1045",
      "page": null,
      "quote": "A warrantless search preceding an arrest is a legitimate 'search incident to arrest' as long as (1) a legitimate basis for the arrest existed before the search, and (2) the arrest followed shortly after the search.",
      "star_marker": "1045",
      "quote_fidelity": "matched",
      "pinpoint_status": "star-verified",
      "position": null
    },
