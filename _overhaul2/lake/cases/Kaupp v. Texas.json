  "pinpoints": [
    {
      "id": "pin-630",
      "page": null,
      "quote": "Such involuntary transport to a police station for questioning is 'sufficiently like arres[t] to invoke the traditional rule that arrests may constitutionally be made only on probable cause.'",
      "star_marker": "630",
      "quote_fidelity": "matched",
      "pinpoint_status": "star-verified",
      "position": null
    },
    {
      "id": "pin-632",
      "page": null,
      "quote": "well-established precedent requires suppression of the confession unless that confession was 'an act of free will [sufficient] to purge the primary taint of the unlawful invasion,'",
      "star_marker": null,
      "quote_fidelity": "mismatch",
      "pinpoint_status": "slip-only",
      "position": null
    },
    {
      "id": "pin-631",
      "page": null,
      "quote": "even more starkly than the facts in *Dunaway*.",
      "star_marker": null,
      "quote_fidelity": "mismatch",
      "pinpoint_status": "slip-only",
      "position": null
    }
  ],
