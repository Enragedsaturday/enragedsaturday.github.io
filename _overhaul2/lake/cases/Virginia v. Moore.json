  "pinpoints": [
    {
      "id": "pin-1607",
      "page": "1607",
      "quote": "[W]arrantless arrests for crimes committed in the presence of an arresting officer are reasonable under the Constitution, and . . . while States are free to regulate such arrests however they desire, state restrictions do not alter the Fourth Amendment's protections.",
      "star_marker": null,
      "quote_fidelity": "matched",
      "pinpoint_status": "slip-only",
      "position": null
    },
    {
      "id": "pin-1608",
      "page": null,
      "quote": "officers may perform searches incident to constitutionally permissible arrests in order to ensure their safety and safeguard evidence",
      "star_marker": null,
      "quote_fidelity": "mismatch",
      "pinpoint_status": "slip-only",
      "position": null
    }
  ],
