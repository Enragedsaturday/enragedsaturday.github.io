  "pinpoints": [
    {
      "id": "pin-1039",
      "page": null,
      "quote": "The 'body' or identity of a defendant or respondent in a criminal or civil proceeding is never itself suppressible as a fruit of an unlawful arrest, even if it is conceded that an unlawful arrest, search, or interrogation occurred.",
      "star_marker": "1039",
      "quote_fidelity": "matched",
      "pinpoint_status": "star-verified",
