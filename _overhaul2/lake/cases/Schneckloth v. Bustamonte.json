  "pinpoints": [
    {
      "id": "pin-227",
      "page": null,
      "quote": "[T]he question whether a consent to a search was in fact \u201cvoluntary\u201d or was the product of duress or coercion, express or implied, is a question of fact to be determined from the totality of all the circumstances.",
      "star_marker": "227",
      "quote_fidelity": "matched",
      "pinpoint_status": "star-verified",
      "position": null
    },
    {
      "id": "pin-227a",
      "page": null,
      "quote": "While knowledge of the right to refuse consent is one factor to be taken into account, the government need not establish such knowledge as the *sine qua non* of an effective consent.",
      "star_marker": null,
      "quote_fidelity": "mismatch",
      "pinpoint_status": "slip-only",
