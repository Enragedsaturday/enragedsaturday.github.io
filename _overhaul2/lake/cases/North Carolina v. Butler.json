  "pinpoints": [
    {
      "id": "pin-373",
      "page": null,
      "quote": "An express written or oral statement of waiver of the right to remain silent or of the right to counsel is usually strong proof of the validity of that waiver, but is not inevitably either necessary or sufficient to establish waiver.",
      "star_marker": "373",
      "quote_fidelity": "matched",
      "pinpoint_status": "star-verified",
      "position": null
    },
    {
      "id": "pin-373b",
      "page": null,
      "quote": "The courts must presume that a defendant did not waive his rights; the prosecution's burden is great; but in at least some cases waiver can be clearly inferred from the actions and words of the person interrogated.",
      "star_marker": null,
      "quote_fidelity": "mismatch",
      "pinpoint_status": "slip-only",
      "position": null
    }
  ],
