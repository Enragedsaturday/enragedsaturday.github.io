  "pinpoints": [
    {
      "id": "pin-469",
      "page": 469,
      "quote": "[W]hen the State withholds from a criminal defendant evidence that is material to his guilt or punishment, it violates his right to due process of law in violation of the Fourteenth Amendment.",
      "star_marker": null,
      "quote_fidelity": "matched",
      "pinpoint_status": "slip-only",
      "position": null
    },
    {
      "id": "pin-470",
      "page": null,
      "quote": "evidence is 'material' within the meaning of *Brady* when there is a reasonable probability that, had the evidence been disclosed, the result of the proceeding would have been different.",
      "star_marker": null,
      "quote_fidelity": "mismatch",
      "pinpoint_status": "slip-only",
      "position": null
    },
    {
      "id": "pin-470b",
      "page": null,
      "quote": "the obligation to disclose evidence favorable to the defense may arise more broadly under a prosecutor's ethical or statutory obligations.",
      "star_marker": null,
      "quote_fidelity": "mismatch",
      "pinpoint_status": "slip-only",
      "position": null
    }
  ],
