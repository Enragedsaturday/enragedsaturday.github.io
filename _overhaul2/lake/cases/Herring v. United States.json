  "pinpoints": [
    {
      "id": "pin-144",
      "page": null,
      "quote": "To trigger the exclusionary rule, police conduct must be sufficiently deliberate that exclusion can meaningfully deter it, and sufficiently culpable that such deterrence is worth the price paid by the justice system.",
