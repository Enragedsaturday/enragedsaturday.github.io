  "pinpoints": [
    {
      "id": "pin-717",
      "page": null,
      "quote": "Individuals do not lose Fourth Amendment rights merely because they work for the government instead of a private employer. The operational realities of the workplace, however, may make some employees' expectations of privacy unreasonable when an intrusion is by a supervisor rather than a law enforcement official.",
      "star_marker": "717",
      "quote_fidelity": "matched",
      "pinpoint_status": "star-verified",
      "position": null
    },
    {
      "id": "pin-725",
      "page": null,
      "quote": "We hold, therefore, that public employer intrusions on the constitutionally protected privacy interests of government employees for noninvestigatory, work-related purposes, as well as for investigations of work-related misconduct, should be judged by the standard of reasonableness under all the circumstances. Under this reasonableness standard, both the inception and the scope of the intrusion must be reasonable.",
      "star_marker": null,
      "quote_fidelity": "mismatch",
      "pinpoint_status": "slip-only",
      "position": null
    }
  ],
