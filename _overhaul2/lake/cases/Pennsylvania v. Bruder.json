  "pinpoints": [
    {
      "id": "pin-10",
      "page": "10",
      "quote": "he was not entitled to a recitation of his constitutional rights prior to arrest, and his roadside responses to questioning were admissible.",
      "star_marker": "10",
      "quote_fidelity": "matched",
      "pinpoint_status": "star-verified",
      "position": null
    },
    {
      "id": "pin-11",
      "page": "11",
      "quote": "Accordingly, *Berkemer*'s rule, that ordinary traffic stops do not involve custody for purposes of *Miranda*, governs this case.",
      "star_marker": "11",
      "quote_fidelity": "matched",
      "pinpoint_status": "star-verified",
